# Project Configuration
COMPOSE_PROJECT_NAME=talent_track

# MongoDB Configuration
MONGO_URI=mongodb://username:password@host:port/database?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_this_secure_password
MONGODB_CONNECTION_POOL_SIZE=20
MONGODB_SOCKET_TIMEOUT=30000

# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_TIMEZONE=UTC
MAX_REQUEST_SIZE=10mb

# Authentication
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15

# Flask Microservices Configuration
FLASK_ENV=development
FLASK_APP=app.py

# Resume Parser Configuration
RESUME_PARSER_PORT=5001
RESUME_PARSER_MAX_FILE_SIZE=5mb
RESUME_PARSER_SUPPORTED_FORMATS=pdf,docx,txt

# Code Executor Configuration
CODE_EXECUTOR_PORT=5002
CODE_EXECUTOR_MAX_EXECUTION_TIME=10
CODE_EXECUTOR_MEMORY_LIMIT=256M
CODE_EXECUTOR_SUPPORTED_LANGUAGES=python,javascript,java,cpp

# AI Evaluator Configuration
AI_EVALUATOR_PORT=5003
AI_EVALUATOR_NLP_MODEL=en_core_web_sm
AI_EVALUATOR_MAX_RESPONSE_LENGTH=1000

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_MAX_FILES=10
LOG_MAX_SIZE=50m

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_redis_password
REDIS_CACHE_TTL=3600
REDIS_CONNECTION_TIMEOUT=5000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@talenttrack.com
EMAIL_TEMPLATES_DIR=/app/email-templates

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
RATE_LIMIT_HEADERS=true

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_RESUME_PARSER_URL=http://localhost:5001
VITE_CODE_EXECUTOR_URL=http://localhost:5002
VITE_AI_EVALUATOR_URL=http://localhost:5003

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Security Configuration
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
X_FRAME_OPTIONS=DENY

# Test Configuration
TEST_TIME_LIMIT=120
MAX_TEST_ATTEMPTS=3
TEST_AUTO_SUBMIT=true
TEST_SAVE_INTERVAL=30
TEST_CACHE_TTL=3600
MAX_CONCURRENT_TESTS=50

# Job Matching Configuration
JOB_MATCH_ALGORITHM=weighted_skills
JOB_MATCH_THRESHOLD=0.7
SKILL_EXTRACTION_CONFIDENCE=0.8
