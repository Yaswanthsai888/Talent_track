# MongoDB Configuration
MONGO_URI=mongodb://root:rootpassword@mongo:27017/recruitment?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_production_jwt_secret_here

# Frontend Configuration
VITE_API_URL=/api

# CORS Configuration
CORS_ORIGINS=http://localhost:80,http://frontend

# Test Configuration
TEST_AUTO_SUBMIT=true
TEST_SAVE_INTERVAL=30
MAX_TEST_ATTEMPTS=3
TEST_TIME_LIMIT=120

# Code Evaluator Configuration
CODE_EVALUATOR_URL=http://code-evaluator:5002
MAX_EXECUTION_TIME=5
MEMORY_LIMIT=100M

# Security Settings
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Judge0 API Configuration
JUDGE0_API=http://judge0:2358
