PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/talent_track
MONGO_DEBUG=true

# JWT Authentication
JWT_SECRET=replace_with_your_secret_key
JWT_EXPIRATION=30d
JWT_REFRESH_SECRET=replace_with_your_refresh_secret
JWT_REFRESH_EXPIRATION=90d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS Configuration
CORS_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:5173,http://localhost:5000

# External Service URLs
RESUME_PARSER_URL=http://localhost:5001
JUDGE0_API=http://localhost:2358
JUDGE0_TOKEN=your_judge0_token_here
